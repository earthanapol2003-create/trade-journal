    def backup_database(self):
        try:
            if not os.path.exists(BACKUP_DIR):
                os.makedirs(BACKUP_DIR)
                
            timestamp = datetime.now().strftime("%d-%m-%Y_%H%M%S")
            backup_sub = os.path.join(BACKUP_DIR, f"Backup_{timestamp}")
            os.makedirs(backup_sub)

            if os.path.exists(FILENAME):
                shutil.copy(FILENAME, backup_sub)
            if os.path.exists(CONFIG_FILE):
                shutil.copy(CONFIG_FILE, backup_sub)
            if os.path.exists(RECEIPTS_DIR):
                shutil.copytree(RECEIPTS_DIR, os.path.join(backup_sub, RECEIPTS_DIR))
            if os.path.exists(CHARTS_DIR):
                shutil.copytree(CHARTS_DIR, os.path.join(backup_sub, CHARTS_DIR))

            all_backups = sorted([os.path.join(BACKUP_DIR, d) for d in os.listdir(BACKUP_DIR) if os.path.isdir(os.path.join(BACKUP_DIR, d))])
            max_backups = 5
            if len(all_backups) > max_backups:
                for old_backup in all_backups[:-max_backups]:
                    try:
                        shutil.rmtree(old_backup)
                    except Exception:
                        pass

            messagebox.showinfo("สำเร็จ", f"🛡️ สำรองข้อมูลพอร์ตเรียบร้อยแล้ว!\n(ชื่อโฟลเดอร์: Backup_{timestamp})\nระบบจัดการเก็บไว้ 5 ชุดล่าสุดให้อัตโนมัติครับ!")
        except Exception as e:
            messagebox.showerror("เกิดข้อผิดพลาด", f"ไม่สามารถสำรองข้อมูลได้: {str(e)}")

