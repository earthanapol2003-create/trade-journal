        tk.Label(header_frame, text="📊 EQUITY CURVE PERFORMANCE ANALYSIS", font=("Tahoma", 15, "bold"), fg=self.ACCENT_CYAN, bg=self.BG_MAIN).pack(anchor="w")
        tk.Label(header_frame, text="กราฟแสดงเส้นทางการเติบโตของยอดเงินพอร์ตสุทธิ พร้อมจำลองพื้นที่สะสมกำไร (High-End Terminal View)", font=self.FONT_TEXT, fg=self.TEXT_MUTED, bg=self.BG_MAIN).pack(anchor="w", pady=(2, 0))

        try:
            initial_cap = float(self.entry_initial_cap.get().strip())
        except ValueError:
            initial_cap = get_initial_capital()

        points = []
        current_eq = initial_cap
        points.append((0, current_eq, "เริ่มต้น", "Initial Capital"))

        sorted_rows = sorted(rows, key=lambda x: x[0] if len(x)>0 else "")

        for idx, row in enumerate(sorted_rows, start=1):
            if len(row) >= 5:
                date, sym, act, pnl, withdraw = row[:5]
                try:
                    pnl_f = float(pnl) if pnl else 0.0
                    wd_f = float(withdraw) if withdraw else 0.0
                    current_eq = current_eq + pnl_f - wd_f
                    points.append((idx, current_eq, date, f"{sym} ({act})"))
                except ValueError:
                    pass

        if len(points) <= 1:
            messagebox.showwarning("แจ้งเตือน", "ข้อมูลประวัติยังไม่เพียงพอสำหรับการวาดกราฟครับ")
            eq_win.destroy()
            return

        final_eq = points[-1][1]
        total_profit = final_eq - initial_cap
        profit_color = self.GREEN_COLOR if total_profit >= 0 else self.RED_COLOR

        stat_bar = tk.Frame(eq_win, bg=self.BG_MAIN)
        stat_bar.pack(fill="x", padx=30, pady=(0, 12))

        def make_mini_card(parent, title, val, col):
            f = tk.Frame(parent, bg=self.CARD_BG, padx=14, pady=8, highlightbackground=col, highlightthickness=1)
            f.pack(side="left", fill="x", expand=True, padx=(0, 10) if parent.winfo_children() else 0)
            tk.Label(f, text=title, font=("Tahoma", 9, "bold"), fg=self.TEXT_MUTED, bg=self.CARD_BG).pack(anchor="w")
            tk.Label(f, text=val, font=("Tahoma", 13, "bold"), fg=col, bg=self.CARD_BG).pack(anchor="w", pady=(2,0))

        make_mini_card(stat_bar, "ทุนตั้งต้นพอร์ต", f"${initial_cap:,.2f}", self.ACCENT_PRIMARY)
        make_mini_card(stat_bar, "ยอดพอร์ตปัจจุบัน", f"${final_eq:,.2f}", self.ACCENT_CYAN)
        make_mini_card(stat_bar, "กำไรสุทธิทั้งหมด", f"${total_profit:,.2f}", profit_color)

        canvas_card = tk.Frame(eq_win, bg=self.CARD_BG, padx=15, pady=15, highlightbackground="#334155", highlightthickness=1)
        canvas_card.pack(fill="both", expand=True, padx=30, pady=(0, 25))

        canvas_w = 880
        canvas_h = 420
        canvas = tk.Canvas(canvas_card, width=canvas_w, height=canvas_h, bg=self.CARD_BG, highlightthickness=0)
        canvas.pack(fill="both", expand=True)

        eq_values = [p[1] for p in points]
        min_eq = min(eq_values) * 0.94
        max_eq = max(eq_values) * 1.06
        if max_eq == min_eq:
            max_eq += 100

        margin_x = 90
        margin_y = 45
        draw_w = canvas_w - (margin_x * 2)
        draw_h = canvas_h - (margin_y * 2)

        def get_coords(i, eq):
            x = margin_x + (i / (len(points) - 1)) * draw_w if len(points) > 1 else margin_x
            y = canvas_h - margin_y - ((eq - min_eq) / (max_eq - min_eq)) * draw_h
            return x, y

        grid_steps = 5
        for i in range(grid_steps + 1):
            val = min_eq + (i / grid_steps) * (max_eq - min_eq)
            _, y = get_coords(0, val)
            canvas.create_line(margin_x, y, canvas_w - margin_x, y, fill="#1E293B", dash=(4, 4), width=1)
            canvas.create_text(margin_x - 14, y, text=f"${val:,.0f}", fill=self.TEXT_MUTED, anchor="e", font=("Tahoma", 9, "bold"))

        coord_list = []
        for i, p in enumerate(points):
            x, y = get_coords(i, p[1])
            coord_list.append((x, y))

        base_y = canvas_h - margin_y
        poly_points = [coord_list[0][0], base_y]
        for x, y in coord_list:
            poly_points.extend([x, y])
        poly_points.extend([coord_list[-1][0], base_y])
        
        try:
            canvas.create_polygon(poly_points, fill="#172554", outline="")
        except Exception:
            pass

        for i in range(len(coord_list) - 1):
            x1, y1 = coord_list[i]
            x2, y2 = coord_list[i+1]
            canvas.create_line(x1, y1, x2, y2, fill=self.ACCENT_CYAN, width=3, capstyle=tk.ROUND, joinstyle=tk.ROUND)

        total_pts = len(points)
        step_skip = max(1, total_pts // 8)

        for i, (x, y) in enumerate(coord_list):
            p = points[i]
            canvas.create_oval(x-5, y-5, x+5, y+5, fill=self.ACCENT_PURPLE, outline=self.TEXT_MAIN, width=2)
            if i == 0 or i == total_pts - 1 or i % step_skip == 0:
                canvas.create_text(x, canvas_h - margin_y + 16, text=p[2], fill=self.TEXT_MUTED, font=("Tahoma", 9), angle=25)

