        self.entry_capital.config(state="normal")
        rr_raw = self.entry_rr.get().strip()
        capital_raw = self.entry_capital.get().strip()
        self.check_pnl_input(None)

        try:
            pnl_val = float(pnl_raw) if pnl_raw else 0.0
            if "ขาดทุน" in action and pnl_val > 0:
                pnl = -pnl_val
            elif "กำไร" in action and pnl_val < 0:
                pnl = abs(pnl_val)
            else:
                pnl = pnl_val
        except ValueError:
            pnl = 0.0

        try:
            withdraw = float(withdraw_raw) if withdraw_raw else 0.0
