                if os.path.exists(target_row[9].strip()):
                    try:
                        os.remove(target_row[9].strip())
                    except Exception:
                        pass
            if len(target_row) >= 11 and target_row[10].strip():
                if os.path.exists(target_row[10].strip()):
                    try:
                        os.remove(target_row[10].strip())
                    except Exception:
                        pass

            rows.pop(csv_index)
            with open(FILENAME, mode="w", newline="", encoding="utf-8") as file:
                writer = csv.writer(file)
                if header:
                    writer.writerow(header)
                writer.writerows(rows)

            self.lbl_status.config(text=" ลบรายการและไฟล์รูปภาพที่เกี่ยวข้องเรียบร้อยแล้ว", fg=self.RED_COLOR)
            messagebox.showinfo("สำเร็จ", "🗑️ ลบรายการและไฟล์รูปภาพหลักฐานเรียบร้อยแล้วครับ")
            self.refresh_all_data()

    def refresh_all_data(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        all_rows = []
        available_months = set()
        total_rules_score = 0
        rule_count = 0

        if os.path.exists(FILENAME):
            with open(FILENAME, mode="r", encoding="utf-8") as file:
                reader = csv.reader(file)
                header = next(reader, None)
                for row in reader:
                    if len(row) >= 8:
                        date_str = row[0]
                        rule_status = row[7]
                        try:
                            month_key = date_str[:7]
                            if len(month_key) == 7:
                                available_months.add(month_key)
                        except Exception:
                            pass
                        
                        if "100%" in rule_status:
                            total_rules_score += 1.0
                        elif "เล็กน้อย" in rule_status:
                            total_rules_score += 0.5
                        else:
                            total_rules_score += 0.0
                        rule_count += 1

                        all_rows.append(row)

        sorted_months = sorted(list(available_months), reverse=True)
        filter_options = ["ทั้งหมด (All Time)"] + sorted_months
        current_selection = self.combo_month_filter.get()
        
        self.combo_month_filter['values'] = filter_options
        if current_selection in filter_options:
            self.combo_month_filter.set(current_selection)
        else:
            self.combo_month_filter.current(0)

        selected_filter = self.combo_month_filter.get()

        total_pnl = 0.0
        total_withdrawal = 0.0
        total_trades = 0
        wins = 0

        for row in all_rows:
            if len(row) >= 8:
                try:
                    pnl_float = float(row[3])
                    withdraw_float = float(row[4]) if row[4] else 0.0
                    total_pnl += pnl_float
                    total_withdrawal += withdraw_float
                    if pnl_float != 0:
                        if pnl_float > 0:
                            wins += 1
                        total_trades += 1
                except ValueError:
                    pass

        filtered_pnl = 0.0
        filtered_withdraw = 0.0
        filtered_trades = 0
        filtered_wins = 0

        for row in reversed(all_rows):
            if len(row) >= 8:
                date = row[0]
                sym = row[1]
                act = row[2]
                pnl_val = row[3]
                withdraw_val = row[4]
                rr = row[5]
                capital = row[6]
                rule = row[7]
                has_receipt = "📷 มีสลิป" if len(row) >= 10 and row[9].strip() else "-"
                has_chart = "📈 มีกราฟ" if len(row) >= 11 and row[10].strip() else "-"
                
                month_key = date[:7]
                if selected_filter != "ทั้งหมด (All Time)" and month_key != selected_filter:
                    continue

                try:
                    pnl_float = float(pnl_val)
                    withdraw_float = float(withdraw_val) if withdraw_val else 0.0
                    
                    filtered_pnl += pnl_float
                    filtered_withdraw += withdraw_float
                    
                    if pnl_float != 0:
                        if pnl_float > 0:
                            filtered_wins += 1
                            tag = "win"
                        else:
                            tag = "loss"
                        filtered_trades += 1
                    elif withdraw_float > 0:
                        tag = "withdraw"
                    else:
                        tag = ""

                    pnl_disp = f"+${pnl_float:,.2f}" if pnl_float > 0 else (f"-${abs(pnl_float):,.2f}" if pnl_float < 0 else "$0.00")
                    withdraw_disp = f"${withdraw_float:,.2f}" if withdraw_float > 0 else "-"
                except ValueError:
                    tag = ""
                    pnl_disp = pnl_val
                    withdraw_disp = "-"

                self.tree.insert("", "end", values=(date, sym, pnl_disp, withdraw_disp, rr, capital, rule, has_receipt, has_chart), tags=(tag,))

        try:
            initial_cap = float(self.entry_initial_cap.get().strip())
        except ValueError:
            initial_cap = get_initial_capital()

        current_balance = initial_cap + total_pnl - total_withdrawal
        
        display_pnl = filtered_pnl if selected_filter != "ทั้งหมด (All Time)" else total_pnl
        display_withdraw = filtered_withdraw if selected_filter != "ทั้งหมด (All Time)" else total_withdrawal
        display_trades = filtered_trades if selected_filter != "ทั้งหมด (All Time)" else total_trades
        display_wins = filtered_wins if selected_filter != "ทั้งหมด (All Time)" else wins

        win_rate = (display_wins / display_trades * 100) if display_trades > 0 else 0.0
        pnl_text = f"+${display_pnl:,.2f}" if display_pnl >= 0 else f"-${abs(display_pnl):,.2f}"
        
        grade_str = "N/A"
        grade_color = self.TEXT_MUTED
        if rule_count > 0:
            avg_score = (total_rules_score / rule_count) * 100
            if avg_score >= 90:
                grade_str = "เกรด A (ยอดเยี่ยม 🔥)"
                grade_color = self.GREEN_COLOR
            elif avg_score >= 70:
                grade_str = "เกรด B (ดีมาก 👍)"
                grade_color = self.ACCENT_CYAN
            elif avg_score >= 50:
                grade_str = "เกรด C (ต้องปรับปรุง ⚠️)"
                grade_color = self.ACCENT_AMBER
            else:
                grade_str = "เกรด D (ผิดวินัย 🚨)"
                grade_color = self.RED_COLOR

        self.card_balance_val.config(text=f"${current_balance:,.2f}")
        self.card_pnl_val.config(text=pnl_text, fg=self.GREEN_COLOR if display_pnl >= 0 else self.RED_COLOR)
        self.card_withdraw_val.config(text=f"${display_withdraw:,.2f}")
        self.card_winrate_val.config(text=f"{win_rate:.1f}%")
        self.card_grade_val.config(text=grade_str, fg=grade_color)

